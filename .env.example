# 后端 API 根路径（Vercel 上请在项目 Environment Variables 中配置 Production）
# VITE_API_BASE_URL=https://your-api.example.com/api

# 本地若想模拟线上「登录页任意填 + 选角色进演示」，可设为 true（Vercel 构建默认开启，除非设为 false）
# VITE_PUBLIC_DEMO=true
# VITE_PUBLIC_DEMO=false

# 若线上接口必须带 JWT，在 Vercel 环境变量中配置（勿把真实 token 写进仓库）
# VITE_DEMO_BEARER_TOKEN=
